# La Rufeta - Website
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Site URL (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://larufeta.es

# Email where reservation requests are sent
RESTAURANT_BOOKINGS_EMAIL=reservas@larufeta.es

# Resend API Key for email sending
# Get yours at: https://resend.com
# Leave empty for dev mode (logs emails to console)
RESEND_API_KEY=

# WhatsApp phone number (E.164 format without +)
# Example: 34676939354
NEXT_PUBLIC_WHATSAPP_PHONE=34676939354

# ===========================================
# OPTIONAL
# ===========================================

# Analytics - Plausible domain (without https://)
# Leave empty to disable analytics
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Admin content checklist password
# Used to access /admin/content-checklist
ADMIN_CHECKLIST_PASSWORD=rufeta2024

# reCAPTCHA (disabled by default)
# Get keys at: https://www.google.com/recaptcha
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Maps Embed API Key (optional, for enhanced maps)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
